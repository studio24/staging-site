{
    "name": "studio24/staging-site",
    "description": " A set of simple tools to help manage staging websites ",
    "keywords": [
        "studio24",
        "php",
        "wordpress",
        "craftcms",
        "laravel",
        "symfony",
        "staging",
        "stage",
        "test site",
        "password",
        "staging password",
        "basic auth",
        "authentication",
        "security",
        "banner",
        "staging banner",
        "dev banner"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/studio24/staging-site",
    "require": {
        "php": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": ">10",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Studio24\\StagingSite\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Studio24\\StagingSite\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "cs": "./vendor/bin/phpcs",
        "format": "./vendor/bin/phpcbf",
        "phpstan": "./vendor/bin/phpstan"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
